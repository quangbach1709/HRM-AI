# Ignore sensitive config files
backend/src/main/resources/application.properties
backend/src/main/resources/application-*.properties

# Environment files (contains passwords)
.env
.env.*
!.env.example

# Docker compose (may contain secrets)
docker-compose.yml
docker-compose.*.yml
!docker-compose.example.yml

# IDE files
.idea/
*.iml
.vscode/

# Build outputs
target/
node_modules/
build/
dist/

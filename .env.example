# ========================================
# HRM-AI Environment Configuration
# ========================================
# WARNING: This file contains sensitive data!
# DO NOT commit this file to version control!
# Copy this to .env and fill in your values
# ========================================

# Server Configuration
SERVER_PORT=8080

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hr_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_postgres_password_here

# MongoDB Configuration
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=root
MONGO_PASSWORD=your_secure_mongo_password_here
MONGO_DB=hr_dashboard_db

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=your_secure_rabbitmq_password_here

# JWT Configuration
JWT_SECRET=your_secure_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRATION=86400000

# AI Service Configuration
AI_SERVICE_URL=http://localhost:8000

# Mail Configuration (Gmail)
# Create App Password at: https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Docker Compose Ports (optional)
FRONTEND_PORT=3000
BACKEND_PORT=8080
AI_SERVICE_PORT=8000
RABBITMQ_MGMT_PORT=15672
